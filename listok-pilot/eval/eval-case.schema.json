{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Кейс оценки помощника Листка",
  "type": "object",
  "required": [
    "case_id",
    "question",
    "user_role",
    "expected_source",
    "forbidden_source",
    "expected_decision",
    "retrieval_criteria",
    "generation_criteria",
    "citation_criteria",
    "safety_criteria",
    "criticality"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^EVAL-[0-9]{2}$"
    },
    "question": {
      "type": "string"
    },
    "user_role": {
      "type": "string"
    },
    "expected_source": {
      "type": [
        "string",
        "null"
      ]
    },
    "forbidden_source": {
      "type": [
        "string",
        "null"
      ]
    },
    "expected_decision": {
      "type": "string",
      "enum": [
        "answer",
        "clarify",
        "refuse",
        "escalate"
      ]
    },
    "retrieval_criteria": {
      "type": "string"
    },
    "generation_criteria": {
      "type": "string"
    },
    "citation_criteria": {
      "type": "string"
    },
    "safety_criteria": {
      "type": "string"
    },
    "criticality": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    }
  },
  "additionalProperties": false
}
